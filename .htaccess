# ══════════════════════════════════════════════
# WASOM UPFY v2.0 — .htaccess Principal
# Localização: /htdocs/wasomupfy/.htaccess
# ══════════════════════════════════════════════

Options -Indexes
RewriteEngine On

# ══════════════════════════════════════════════
# PÁGINAS DE ERRO PERSONALIZADAS (Apache)
# Activa quando o Apache gera o erro directamente
# (ficheiro não encontrado, PHP fatal, forbidden
#  por regra .htaccess, servidor sobrecarregado)
# As páginas PHP tratam dos erros gerados pelo
# PARA AS PAGINAS QUANDO O USUARIO ESTIVER LOGADO
# próprio código via http_response_code().
# ══════════════════════════════════════════════

ErrorDocument 400 /wasomupfy/status/404.php
ErrorDocument 403 /wasomupfy/status/403.php
ErrorDocument 404 /wasomupfy/status/404.php
ErrorDocument 405 /wasomupfy/status/404.php
ErrorDocument 500 /wasomupfy/status/500.php
ErrorDocument 502 /wasomupfy/status/503.php
ErrorDocument 503 /wasomupfy/status/503.php
ErrorDocument 504 /wasomupfy/status/503.php
RewriteBase /wasomupfy/

# ══════════════════════════════════════════════
# PÁGINAS DE ERRO PERSONALIZADAS (Apache)
# Activa quando o Apache gera o erro directamente
# (ficheiro não encontrado, PHP fatal, forbidden
#  por regra .htaccess, servidor sobrecarregado)
# As páginas PHP tratam dos erros gerados pelo
# próprio código via http_response_code().
# PARA AS PAGINAS QUANDO O USUARIO ESTIVER LOGADO
# ══════════════════════════════════════════════

ErrorDocument 400 /wasomupfy/dashboard/status/404.php
ErrorDocument 403 /wasomupfy/dashboard/status/403.php
ErrorDocument 404 /wasomupfy/dashboard/status/404.php
ErrorDocument 405 /wasomupfy/dashboard/status/404.php
ErrorDocument 500 /wasomupfy/dashboard/status/500.php
ErrorDocument 502 /wasomupfy/dashboard/status/503.php
ErrorDocument 503 /wasomupfy/dashboard/status/503.php
ErrorDocument 504 /wasomupfy/dashboard/status/503.php

# ─── Bloquear ficheiros sensíveis ─────────────
RewriteRule \.(sql|log|env|sh|bak)$ - [F,L]

# ─── Bloquear acesso directo às pastas include ─
RewriteRule ^(authentic|admin)/include/ - [F,L]

# ─── Se o ficheiro/pasta existir, serve directo ─
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ══════════════════════════════════════════════
# AUTENTICAÇÃO
# ══════════════════════════════════════════════


RewriteRule ^2fa-verify/?$                      authentic/2fa-verify.php [L]
RewriteRule ^2fa-process/?$                     authentic/2fa-process.php [L]
RewriteRule ^login/?$                           authentic/login.php [L]
RewriteRule ^login_process/?$                   authentic/login_process.php [L]
RewriteRule ^register/?$                        authentic/register.php [L]
RewriteRule ^register_process/?$                authentic/register_process.php [L]
RewriteRule ^verify-email/?$                    authentic/verify-email.php [L]
RewriteRule ^forgot-password/?$                 authentic/forgot-password.php [L]
RewriteRule ^forgot-password-process/?$         authentic/forgot-password-process.php [L]
RewriteRule ^confirm-email-code/?$              authentic/confirm-email-code.php [L,QSA]
RewriteRule ^verify-code-process/?$             authentic/verify-code-process.php [L,QSA]
RewriteRule ^reset-password/?$                  authentic/reset-password.php [L,QSA]
RewriteRule ^reset-password-process/?$          authentic/reset-password-process.php [L,QSA]
RewriteRule ^support_process/?$                 authentic/support_process.php [L,QSA]
RewriteRule ^logout/?$                          dashboard/logout.php [L]
RewriteRule ^_modal_support/?$                  dashboard/_modal_support.php [L]


# ══════════════════════════════════════════════
# PÁGINAS PÚBLICAS — RAIZ
# ══════════════════════════════════════════════

RewriteRule ^home/?$                            home.php [L]
RewriteRule ^about/?$                           about.php [L]
RewriteRule ^resources/?$                       resources.php [L]
RewriteRule ^partnership/?$                     partnership.php [L]
RewriteRule ^contact/?$                         contact.php [L]

# ══════════════════════════════════════════════
# PLANOS
# ══════════════════════════════════════════════

RewriteRule ^plan/all-plans/?$                 plan/all-plans.php [L]
RewriteRule ^plan/single/?$                    plan/single.php [L]
RewriteRule ^plan/album/?$                     plan/album.php [L]
RewriteRule ^plan/artist/?$                    plan/artist.php [L]
RewriteRule ^plan/label/?$                     plan/label.php [L]

# ══════════════════════════════════════════════
# BLOG
# ══════════════════════════════════════════════

RewriteRule ^blog/?$                            blog/home.php [L]
RewriteRule ^blog/news/?$                       blog/news.php [L]
RewriteRule ^blog/tutorials/?$                  blog/tutorials.php [L]
RewriteRule ^blog/marketing/?$                  blog/marketing.php [L]
RewriteRule ^blog/([a-z0-9-]+)/?$               blog/posts/$1.php [L,QSA]

# ══════════════════════════════════════════════
# SUPORTE & AJUDA (páginas públicas)
# ══════════════════════════════════════════════

RewriteRule ^page/support/faq/?$                             page/support/faq.php [L]
RewriteRule ^page/support/help/?$                            page/support/help.php [L]
RewriteRule ^page/support/support/?$                         page/support/support.php [L]
RewriteRule ^page/support/tutorial/?$                       page/support/tutorial.php [L]

# ══════════════════════════════════════════════
# SERVIÇOS
# ══════════════════════════════════════════════

RewriteRule ^page/services/music-distribution/?$     page/services/music-distribution.php [L]
RewriteRule ^page/services/music-promotion/?$        page/services/music-promotion.php [L]
RewriteRule ^page/services/customized-services/?$             page/services/customized-services.php [L]
RewriteRule ^page/services/contact/?$             page/services/contact.php [L]

# ══════════════════════════════════════════════
# POLÍTICAS
# ══════════════════════════════════════════════

RewriteRule ^page/politicies/terms/?$                           page/politicies/terms.php [L]
RewriteRule ^page/politicies/privacy/?$                         page/politicies/privacy.php [L]
RewriteRule ^page/politicies/cookies/?$                         page/politicies/cookies.php [L]

# ══════════════════════════════════════════════
# STATUS / ERROS DO SITE PÚBLICO
# ══════════════════════════════════════════════
# Rotas limpas para as páginas da pasta status/
# NUNCA adicionar checkPlatformStatus() nelas.
# offline.php: sem BD nem CDN — servida pelo SW.
# ══════════════════════════════════════════════

RewriteRule ^status/maintenance/?$              status/maintenance.php [L]
RewriteRule ^status/403/?$                      status/403.php [L]
RewriteRule ^status/404/?$                      status/404.php [L]
RewriteRule ^status/500/?$                      status/500.php [L]
RewriteRule ^status/503/?$                      status/503.php [L]
RewriteRule ^status/offline/?$                  status/offline.php [L]

RewriteRule ^dashboard/status/maintenance/?$              dashboard/status/maintenance.php [L]
RewriteRule ^dashboard/status/403/?$                      dashboard/status/403.php [L]
RewriteRule ^dashboard/status/404/?$                      dashboard/status/404.php [L]
RewriteRule ^dashboard/status/500/?$                      dashboard/status/500.php [L]
RewriteRule ^dashboard/status/503/?$                      dashboard/status/503.php [L]
RewriteRule ^dashboard/status/unauthorized/?$             dashboard/status/unauthorized.php [L]

# ══════════════════════════════════════════════
# DASHBOARD — PAINEL PRINCIPAL
# ══════════════════════════════════════════════

RewriteRule ^dashboard/painel/?$                                dashboard/painel.php [L]
RewriteRule ^dashboard/onboarding_done/?$                       dashboard/onboarding_done.php [L]
RewriteRule ^dashboard/all-plans/?$                             dashboard/all-plans.php [L]
RewriteRule ^dashboard/logout/?$                                dashboard/logout.php [L]
RewriteRule ^dashboard/ajax/support_dashboard/?$              dashboard/ajax/support_dashboard.php [L]
RewriteRule ^dashboard/ajax/notifications_api/?$              dashboard/ajax/notifications_api.php [L]

# ─── Account ──────────────────────────────────
RewriteRule ^dashboard/account/add-user/?$                      dashboard/account/add-user.php [L]
RewriteRule ^dashboard/account/manage-account/?$                dashboard/account/manage-account.php [L]
RewriteRule ^dashboard/account/manage_account_process/?$        dashboard/account/manage_account_process.php [L]
RewriteRule ^dashboard/account/collab-activate/?$               dashboard/account/collab-activate.php [L]
RewriteRule ^dashboard/account/collab_activate_process/?$       dashboard/account/collab_activate_process.php [L]
RewriteRule ^dashboard/account/collab-login/?$                  dashboard/account/collab-login.php [L]

# ─── Collaborator ──────────────────────────────────
RewriteRule ^dashboard/collab/overview/?$                       dashboard/collab/overview.php [L]
RewriteRule ^dashboard/collab/releases-ajax/?$                  dashboard/collab/releases_ajax.php [L]
RewriteRule ^dashboard/collab/releases/?$                       dashboard/collab/releases.php [L]
RewriteRule ^dashboard/collab/artists/?$                        dashboard/collab/artists.php [L]
RewriteRule ^dashboard/collab/statistics/?$                     dashboard/collab/statistics.php [L]
RewriteRule ^dashboard/collab/finances/?$                       dashboard/collab/finances.php [L]
RewriteRule ^dashboard/collab/logout/?$                         dashboard/collab/logout.php [L]
RewriteRule ^dashboard/collab/ping/?$                           dashboard/collab/ping.php [L]

RewriteRule ^dashboard/collab/middleware/?$                     dashboard/collab/middleware.php [L]
RewriteRule ^dashboard/collab/artists-list/?$                   dashboard/collab/artists-list.php [L]
RewriteRule ^dashboard/collab/blocked/?$                        dashboard/collab/blocked.php [L]
RewriteRule ^dashboard/collab/navbar/?$                         dashboard/collab/navbar.php [L]
RewriteRule ^dashboard/collab/releases/?$                       dashboard/collab/releases.php [L]

# ─── Profile ──────────────────────────────────
RewriteRule ^dashboard/user/profile/?$                          dashboard/user/profile.php [L]
RewriteRule ^dashboard/user/profile_process/?$                  dashboard/user/profile_process.php [L]

# ─── Analytics ────────────────────────────────
RewriteRule ^dashboard/analytics/statistics/?$                  dashboard/analytics/statistics.php [L]
RewriteRule ^dashboard/analytics/export/?$                      dashboard/analytics/export.php [L]
RewriteRule ^dashboard/analytics/report/?$                      dashboard/analytics/report.php [L]
RewriteRule ^dashboard/analytics/compare/?$                     dashboard/analytics/compare.php [L]
RewriteRule ^dashboard/analytics/launches/?$                    dashboard/analytics/launches.php [L]
RewriteRule ^dashboard/analytics/artist-details/?$              dashboard/analytics/artist-details.php [L]
RewriteRule ^dashboard/analytics/country-details/?$             dashboard/analytics/country-details.php [L]
RewriteRule ^dashboard/analytics/playlist-details/?$            dashboard/analytics/playlist-details.php [L]

# ─── Artistas ─────────────────────────────────
RewriteRule ^dashboard/artists/artists-list/?$                  dashboard/artists/artists-list.php [L]
RewriteRule ^dashboard/artists/add-artist/?$                    dashboard/artists/add-artist.php [L]
RewriteRule ^dashboard/artists/add_artist_process/?$            dashboard/artists/add_artist_process.php [L]
RewriteRule ^dashboard/artists/youtube/ucy/?$                   dashboard/artists/youtube/ucy.php [L]
RewriteRule ^dashboard/artists/youtube/ucy_process/?$             dashboard/artists/youtube/ucy_process.php [L]

# ─── Finanças ─────────────────────────────────
RewriteRule ^dashboard/finances/?$                              dashboard/finances/overview.php [L]
RewriteRule ^dashboard/finances/overview/?$                     dashboard/finances/overview.php [L]
RewriteRule ^dashboard/finances/transactions/?$                 dashboard/finances/transactions.php [L]
RewriteRule ^dashboard/finances/withdraw/?$                     dashboard/finances/withdraw.php [L]
RewriteRule ^dashboard/finances/withdrawal_process/?$           dashboard/finances/withdrawal_process.php [L]
RewriteRule ^dashboard/finances/_modal_withdrawal/?$            dashboard/finances/_modal_withdrawal.php [L]
RewriteRule ^dashboard/finances/account_process/?$              dashboard/finances/account_process.php [L]

# ─── Lançamentos ──────────────────────────────
RewriteRule ^dashboard/launch/releases/?$                       dashboard/launch/releases.php [L]
RewriteRule ^dashboard/launch/releases_process/?$               dashboard/launch/releases_process.php [L]
RewriteRule ^dashboard/launch/creat_release_process/?$          dashboard/launch/creat_release_process.php [L]
RewriteRule ^dashboard/launch/creat-release/?$                  dashboard/launch/creat-release.php [L]
RewriteRule ^dashboard/launch/draft-release/?$                  dashboard/launch/draft-release.php [L]
RewriteRule ^dashboard/launch/edit-release/?$                   dashboard/launch/edit-release.php [L]


# ─── Páginas internas do painel ───────────────
RewriteRule ^dashboard/page/notifications/?$                    dashboard/page/notifications.php [L]
RewriteRule ^dashboard/page/settings/?$                         dashboard/page/settings.php [L]
RewriteRule ^dashboard/page/settings_process/?$                 dashboard/page/settings_process.php [L]
RewriteRule ^dashboard/page/support/?$                          dashboard/page/support.php [L]
RewriteRule ^dashboard/page/faq/?$                              dashboard/page/faq.php [L]
RewriteRule ^dashboard/page/help/?$                             dashboard/page/help.php [L]
RewriteRule ^dashboard/page/about/?$                            dashboard/page/about.php [L]
RewriteRule ^dashboard/page/politicies/terms/?$                 dashboard/page/politicies/terms.php [L]
RewriteRule ^dashboard/page/politicies/privacy/?$               dashboard/page/politicies/privacy.php [L]
RewriteRule ^dashboard/services/available-services/?$           dashboard/services/available-services.php [L]

RewriteRule ^dashboard/payment/pay/?$                           dashboard/payment/pay.php [L]
RewriteRule ^dashboard/payment/payment_process/?$               dashboard/payment/payment_process.php [L]

# ─── Erros do painel ──────────────────────────
RewriteRule ^dashboard/offline/?$                               dashboard/offline.php [L]
RewriteRule ^dashboard/error/403/?$                             dashboard/page/error/403.php [L]
RewriteRule ^dashboard/error/404/?$                             dashboard/page/error/404.php [L]
RewriteRule ^dashboard/error/500/?$                             dashboard/page/error/500.php [L]
RewriteRule ^dashboard/error/503/?$                             dashboard/page/error/503.php [L]
RewriteRule ^dashboard/maintenance/?$                           dashboard/page/error/maintenance.php [L]

# ══════════════════════════════════════════════
# PAINEL ADMIN — AUTH
# ══════════════════════════════════════════════

RewriteRule ^admin/login/?$                     admin/auth/login.php [L]
RewriteRule ^admin/login-process/?$             admin/auth/login-process.php [L]
RewriteRule ^admin/logout/?$                    admin/auth/logout.php [L]
RewriteRule ^admin/forgot-password/?$           admin/auth/forgot-password.php [L]
RewriteRule ^admin/forgot-password-process/?$   admin/auth/forgot-password-process.php [L]
RewriteRule ^admin/reset-password/?$            admin/auth/reset-password.php [L,QSA]
RewriteRule ^admin/reset-password-process/?$    admin/auth/reset-password-process.php [L,QSA]
RewriteRule ^admin/confirm-code/?$              admin/auth/confirm-email-code.php [L,QSA]
RewriteRule ^admin/lockscreen/?$                admin/auth/lockscreen.php [L]
RewriteRule ^admin/lockscreen-process/?$        admin/auth/lockscreen-process.php [L]

# ══════════════════════════════════════════════
# PAINEL ADMIN — PÁGINAS (a adicionar quando chegarmos lá)
# ══════════════════════════════════════════════

RewriteRule ^admin/?$                           admin/home.php [L]

# ══════════════════════════════════════════════
# FALLBACK — .php na raiz sem extensão
# ══════════════════════════════════════════════

RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([a-z0-9-]+)/?$   $1.php [L]

# Fallback — .php na raiz sem extensão
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([a-z0-9-]+)/?$   $1.php [L]

# ══════════════════════════════════════════════
# CABEÇALHOS DE SEGURANÇA
# ══════════════════════════════════════════════

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ══════════════════════════════════════════════
# CACHE & PERFORMANCE
# ══════════════════════════════════════════════

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg             "access plus 1 month"
    ExpiresByType image/png              "access plus 1 month"
    ExpiresByType image/webp             "access plus 1 month"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType text/css               "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
