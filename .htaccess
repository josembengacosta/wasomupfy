# ══════════════════════════════════════════════
# WASOM UPFY v2.0 — .htaccess RAIZ
# Localização: /.htaccess
# Contém: páginas públicas, auth, planos, blog,
#         suporte, serviços, políticas, status
# ══════════════════════════════════════════════

AddHandler application/x-httpd-php82 .php
Options -Indexes
RewriteEngine On
RewriteBase /

# Redirecionar raiz para /home
RewriteRule ^$ /home [L,R=302]

# Erros do site público
ErrorDocument 400 /status/404.php
ErrorDocument 403 /status/403.php
ErrorDocument 404 /status/404.php
ErrorDocument 405 /status/404.php
ErrorDocument 500 /status/500.php
ErrorDocument 502 /status/503.php
ErrorDocument 503 /status/503.php
ErrorDocument 504 /status/503.php

# Bloquear ficheiros sensíveis
RewriteRule \.(sql|log|env|sh|bak)$ - [F,L]

# Servir ficheiros e pastas reais directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Autenticação ──
RewriteRule ^2fa-verify/?$               authentic/2fa-verify.php [L]
RewriteRule ^2fa-process/?$              authentic/2fa-process.php [L]
RewriteRule ^login/?$                    authentic/login.php [L]
RewriteRule ^login_process/?$            authentic/login_process.php [L]
RewriteRule ^register/?$                 authentic/register.php [L]
RewriteRule ^register_process/?$         authentic/register_process.php [L]
RewriteRule ^verify-email/?$             authentic/verify-email.php [L]
RewriteRule ^forgot-password/?$          authentic/forgot-password.php [L]
RewriteRule ^forgot-password-process/?$  authentic/forgot-password-process.php [L]
RewriteRule ^confirm-email-code/?$       authentic/confirm-email-code.php [L,QSA]
RewriteRule ^verify-code-process/?$      authentic/verify-code-process.php [L,QSA]
RewriteRule ^reset-password/?$           authentic/reset-password.php [L,QSA]
RewriteRule ^reset-password-process/?$   authentic/reset-password-process.php [L,QSA]
RewriteRule ^support_process/?$          authentic/support_process.php [L,QSA]
RewriteRule ^logout/?$                   dashboard/logout.php [L]
RewriteRule ^_modal_support/?$           dashboard/_modal_support.php [L]

# ── Páginas públicas ──
RewriteRule ^home/?$                     home.php [L]
RewriteRule ^about/?$                    about.php [L]
RewriteRule ^resources/?$                resources.php [L]
RewriteRule ^partnership/?$              partnership.php [L]
RewriteRule ^contact/?$                  contact.php [L]

# ── Planos ──
RewriteRule ^plan/all-plans/?$           plan/all-plans.php [L]
RewriteRule ^plan/single/?$              plan/single.php [L]
RewriteRule ^plan/album/?$               plan/album.php [L]
RewriteRule ^plan/artist/?$              plan/artist.php [L]
RewriteRule ^plan/label/?$               plan/label.php [L]

# ── Blog ──
RewriteRule ^blog/?$                     blog/home.php [L]
RewriteRule ^blog/news/?$                blog/news.php [L]
RewriteRule ^blog/tutorials/?$           blog/tutorials.php [L]
RewriteRule ^blog/marketing/?$           blog/marketing.php [L]
RewriteRule ^blog/([a-z0-9-]+)/?$        blog/posts/$1.php [L,QSA]

# ── Suporte & Ajuda ──
RewriteRule ^page/support/faq/?$         page/support/faq.php [L]
RewriteRule ^page/support/help/?$        page/support/help.php [L]
RewriteRule ^page/support/support/?$     page/support/support.php [L]
RewriteRule ^page/support/tutorial/?$    page/support/tutorial.php [L]

# ── Serviços ──
RewriteRule ^page/services/music-distribution/?$   page/services/music-distribution.php [L]
RewriteRule ^page/services/music-promotion/?$      page/services/music-promotion.php [L]
RewriteRule ^page/services/customized-services/?$  page/services/customized-services.php [L]
RewriteRule ^page/services/contact/?$              page/services/contact.php [L]

# ── Políticas ──
RewriteRule ^page/politicies/terms/?$    page/politicies/terms.php [L]
RewriteRule ^page/politicies/privacy/?$  page/politicies/privacy.php [L]
RewriteRule ^page/politicies/cookies/?$  page/politicies/cookies.php [L]

# ── Status / Erros públicos ──
RewriteRule ^status/maintenance/?$       status/maintenance.php [L]
RewriteRule ^status/403/?$               status/403.php [L]
RewriteRule ^status/404/?$               status/404.php [L]
RewriteRule ^status/500/?$               status/500.php [L]
RewriteRule ^status/503/?$               status/503.php [L]
RewriteRule ^status/offline/?$           status/offline.php [L]

# ── Fallback: .php na raiz sem extensão ──
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([a-z0-9-]+)/?$             $1.php [L]

# ── Headers de segurança ──
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ── Cache & Performance ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg             "access plus 1 month"
    ExpiresByType image/png              "access plus 1 month"
    ExpiresByType image/webp             "access plus 1 month"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType text/css               "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
php_value date.timezone Africa/Luanda
