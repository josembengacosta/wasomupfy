RewriteRule ^wu-panel/manager/top-music/?$             wu-panel/pages/manager/top-music.php [L]



# ── Integração ──
RewriteRule ^wu-panel/integration/verify/?$            wu-panel/pages/integration/verify.php [L]
RewriteRule ^wu-panel/integration/verify-channel/?$    wu-panel/pages/integration/verify-channel.php [L]
RewriteRule ^wu-panel/integration/edit/?$               wu-panel/pages/integration/edit.php [L,QSA]
RewriteRule ^wu-panel/integration/edit-process/?$       wu-panel/pages/integration/edit-process.php [L]
RewriteRule ^wu-panel/integration/verify-process/?$    wu-panel/pages/integration/verify-process.php [L]


# ── Mensagens ──
RewriteRule ^wu-panel/messages/inbox/?$                wu-panel/pages/messages/inbox.php [L]
RewriteRule ^wu-panel/messages/inbox-process/?$        wu-panel/pages/messages/inbox-process.php [L]

# ── Ajuda ──
RewriteRule ^wu-panel/help/contact/?$                  wu-panel/pages/help/contact.php [L]

# ── Configurações + Segurança ──
RewriteRule ^wu-panel/settings/?$                      wu-panel/pages/settings/config.php [L]
RewriteRule ^wu-panel/settings/config-process/?$       wu-panel/pages/settings/config-process.php [L]
RewriteRule ^wu-panel/settings/security/?$             wu-panel/pages/settings/security.php [L]
RewriteRule ^wu-panel/settings/security-process/?$     wu-panel/pages/settings/security-process.php [L]
RewriteRule ^wu-panel/audit/?$                         wu-panel/pages/manager/audit.php [L,QSA]

# FAQ Admin
RewriteRule ^wu-panel/faq/?$                      wu-panel/pages/faq/faq.php [L]
RewriteRule ^wu-panel/faq_process/?$              wu-panel/pages/faq/faq_process.php [L]

# ##WASOM_ADMIN_END## — NÃO remover esta linha

# ══════════════════════════════════════════════
# FALLBACK — .php na raiz sem extensão
# ══════════════════════════════════════════════

RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([a-z0-9-]+)/?$   $1.php [L]

# Fallback — .php na raiz sem extensão
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([a-z0-9-]+)/?$   $1.php [L]

# ══════════════════════════════════════════════
# CABEÇALHOS DE SEGURANÇA
# ══════════════════════════════════════════════

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ══════════════════════════════════════════════
# CACHE & PERFORMANCE
# ══════════════════════════════════════════════

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg             "access plus 1 month"
    ExpiresByType image/png              "access plus 1 month"
    ExpiresByType image/webp             "access plus 1 month"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType text/css               "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
