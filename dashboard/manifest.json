{
  "name": "Wasom Upfy",
  "short_name": "Wasom Upfy",
  "description": "Gerencie suas músicas, estatísticas e finanças com o Wasom Upfy v2.0",
  "version": "2.0",

  "start_url": "/painel.html",
  "scope": "/",

  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],

  "background_color": "#181818",
  "theme_color": "#FF0089",

  "orientation": "portrait-primary",

  "icons": [
    {
      "src": "/assets/img/icones/wasomupfy_fiv.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/img/icones/wasomupfy_fiv_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/img/icones/wasomupfy_fiv_maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "screenshots": [
    {
      "src": "/assets/img/screenshots/dashboard.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tela principal do Wasom Upfy"
    },
    {
      "src": "/assets/img/screenshots/releases.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Área de lançamentos"
    },
    {
      "src": "/assets/img/screenshots/settings.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Configurações do Wasom Upfy"
    }
  ],

  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Painel",
      "description": "Acesse o painel principal",
      "url": "/painel.html",
      "icons": [{
        "src": "/assets/img/icones/wasomupfy_fiv.png",
        "sizes": "192x192",
        "type": "image/png"
      }]
    },
    {
      "name": "Lançamentos",
      "short_name": "Lançamentos",
      "description": "Área de lançamentos",
      "url": "/launch/releases.html",
      "icons": [{
        "src": "/assets/img/icones/wasomupfy_fiv.png",
        "sizes": "192x192",
        "type": "image/png"
      }]
    },
    {
      "name": "Configurações",
      "short_name": "Config",
      "description": "Personalize sua experiência",
      "url": "/settings.html",
      "icons": [{
        "src": "/assets/img/icones/wasomupfy_fiv.png",
        "sizes": "192x192",
        "type": "image/png"
      }]
    }
  ],

  "categories": ["music", "productivity"],

  "lang": "pt-BR",
  "dir": "ltr",

  "prefer_related_applications": false,
  "related_applications": [],

  "share_target": {
    "action": "/painel.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "launch_handler": {
    "client_mode": ["focus-existing", "navigate-new"]
  }
}