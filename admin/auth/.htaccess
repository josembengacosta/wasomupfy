# ══════════════════════════════════════════════
# WASOM UPFY v2.0 — .htaccess da pasta admin/auth
# Localização: /wasomupfy/admin/auth/.htaccess
# ══════════════════════════════════════════════

Options -Indexes

RewriteEngine On

# ─── Bloquear acesso directo à pasta include ───
RewriteRule ^include/ - [F,L]

# ─── Bloquear _process.php via GET ─────────────
RewriteCond %{REQUEST_METHOD} !POST
RewriteRule _process\.php$ /wasomupfy/admin/login [R=302,L]

# ─── Redirecionar admin já autenticado ─────────
# (a verificação real é feita no PHP)