# ═════════════════════════════════════════════════════════════════
# .env.example — WASOMUPFY v2.0 Configuration Template
# ═════════════════════════════════════════════════════════════════
# 
# Instruções:
# 1. Copiar este ficheiro: cp .env.example .env
# 2. Abrir .env e substituir PUT_YOUR_*_HERE pelos valores reais
# 3. NUNCA commitar .env no Git
# 4. NUNCA compartilhar valores .env por email/chat
#
# ═════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# APLICAÇÃO
# ─────────────────────────────────────────────────────────────────
APP_NAME=Wasom Upfy
APP_ENV=production
APP_DEBUG=false
APP_KEY=PUT_YOUR_APP_KEY_HERE_64_CHARS_MIN
APP_URL=https://www.wasomupfy.com
APP_TIMEZONE=Africa/Luanda

# ─────────────────────────────────────────────────────────────────
# BANCO DE DADOS
# ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wasomupfy_db
DB_USER=wasomupfy_app
DB_PASS=PUT_YOUR_DB_PASSWORD_HERE_STRONG_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ─────────────────────────────────────────────────────────────────
# EMAIL (SMTP)
# ─────────────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_ENCRYPTION=tls
MAIL_USER=PUT_YOUR_MAILTRAP_EMAIL_HERE
MAIL_PASS=PUT_YOUR_MAILTRAP_PASSWORD_HERE
MAIL_FROM_ADDRESS=noreply@wasomupfy.com
MAIL_FROM_NAME=Wasom Upfy

# Alternativa: Gmail SMTP
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USER=seu_email@gmail.com
# MAIL_PASS=sua_app_password  (NÃO a password do Google Account)

# ─────────────────────────────────────────────────────────────────
# SEGURANÇA & CRIPTOGRAFIA
# ─────────────────────────────────────────────────────────────────
JWT_SECRET=PUT_YOUR_JWT_SECRET_HERE_64_CHARS_MIN
CIPHER=AES-256-CBC
ENCRYPTION_KEY=PUT_YOUR_ENCRYPTION_KEY_HERE

# Gerar chave segura (no terminal):
# php -r "echo 'APP_KEY=' . bin2hex(random_bytes(32));"
# php -r "echo 'JWT_SECRET=' . bin2hex(random_bytes(32));"

# ─────────────────────────────────────────────────────────────────
# ADMIN & AUTENTICAÇÃO
# ─────────────────────────────────────────────────────────────────
ADMIN_PATH=admin1
SESSION_TIMEOUT=60
MAX_LOGIN_ATTEMPTS=5
BLOCK_LOCKOUT_MINUTES=30
2FA_ENABLED=true
2FA_METHOD=totp

# ─────────────────────────────────────────────────────────────────
# NOTIFICAÇÕES PUSH (Web Push)
# ─────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=PUT_YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=PUT_YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:admin@wasomupfy.com

# Gerar chaves VAPID:
# npm install -g web-push
# npx web-push generate-vapid-keys

# ─────────────────────────────────────────────────────────────────
# INTEGRAÇÕES EXTERNAS
# ─────────────────────────────────────────────────────────────────
# Stripe (Pagamentos)
STRIPE_PUBLIC_KEY=pk_live_PUT_YOUR_STRIPE_PUBLIC_KEY_HERE
STRIPE_SECRET_KEY=sk_live_PUT_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_PUT_YOUR_STRIPE_WEBHOOK_SECRET_HERE

# PayPal
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=PUT_YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_SECRET=PUT_YOUR_PAYPAL_SECRET_HERE

# SendGrid (Email API alternativo)
# SENDGRID_API_KEY=PUT_YOUR_SENDGRID_API_KEY_HERE

# Mailgun (Email API)
# MAILGUN_DOMAIN=PUT_YOUR_MAILGUN_DOMAIN_HERE
# MAILGUN_API_KEY=PUT_YOUR_MAILGUN_API_KEY_HERE

# ─────────────────────────────────────────────────────────────────
# REDES SOCIAIS (OAuth)
# ─────────────────────────────────────────────────────────────────
# Google
GOOGLE_CLIENT_ID=PUT_YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PUT_YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_CALLBACK_URL=${APP_URL}/auth/callback/google

# Facebook
FACEBOOK_APP_ID=PUT_YOUR_FACEBOOK_APP_ID_HERE
FACEBOOK_APP_SECRET=PUT_YOUR_FACEBOOK_APP_SECRET_HERE
FACEBOOK_CALLBACK_URL=${APP_URL}/auth/callback/facebook

# ─────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_MAX_FILES=30
LOG_RETENTION_DAYS=90
ERROR_REPORTING=0
DISPLAY_ERRORS=0

# ─────────────────────────────────────────────────────────────────
# PERFORMANCE & CACHE
# ─────────────────────────────────────────────────────────────────
CACHE_DRIVER=file
CACHE_TTL=3600
SESSION_DRIVER=file
SESSION_LIFETIME=1440

# Alternativa: Redis (mais rápido)
# CACHE_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────
# ARQUIVOS & UPLOADS
# ─────────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=104857600  # 100MB em bytes
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,mp3,mp4,wav
UPLOAD_STORAGE_PATH=/var/www/private/uploads
UPLOAD_TEMP_PATH=/tmp

# ─────────────────────────────────────────────────────────────────
# DESENVOLVIMENTO (APENAS PARA LOCAL)
# ─────────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
QUERY_LOG=true
MAIL_TRAP=true

# ═════════════════════════════════════════════════════════════════
# 🔒 NOTAS DE SEGURANÇA
# ═════════════════════════════════════════════════════════════════
#
# 1. NUNCA commitar este ficheiro .env no Git
#    → Adicionar ao .gitignore: já está ✓
#
# 2. Senha de BD:
#    - Mínimo 20 caracteres
#    - Incluir: maiúsculas + minúsculas + números + símbolos
#    - Exemplo: P@ssw0rd!xY7kL#mN9$vB2
#
# 3. Chaves de API:
#    - Regenerar anualmente
#    - Usar chaves específicas por ambiente (dev ≠ prod)
#    - Revogar se expostas
#
# 4. Backups:
#    - Backup manual do .env em local seguro
#    - Usar password manager (1Password, Bitwarden, LastPass)
#
# 5. Auditoria:
#    - Registar quem tem acesso a .env
#    - Renovar credentials após saída de colaboradores
#
# ═════════════════════════════════════════════════════════════════
